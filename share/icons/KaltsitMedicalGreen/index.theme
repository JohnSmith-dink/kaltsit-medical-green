[Icon Theme]
Name=Kaltsit Medical Green
Name[zh_CN]=凯尔希 · 医疗白绿
Comment=Original medical green folders with Breeze application icons
Comment[zh_CN]=原创医疗青绿文件夹，继承 Breeze 应用图标
Inherits=breeze,hicolor
Example=folder
FollowsColorScheme=false
DesktopDefault=48
DesktopSizes=16,22,32,48,64,96,128,256
ToolbarDefault=22
ToolbarSizes=16,22,32,48
SmallDefault=16
SmallSizes=16,22,32,48
PanelDefault=48
PanelSizes=16,22,32,48,64,96,128,256
DialogDefault=32
DialogSizes=16,22,32,48,64,96,128,256
KDE-Extensions=.svg
Directories=places/16,places/22,places/32,places/scalable

[places/scalable]
Size=64
MinSize=33
MaxSize=512
Context=Places
Type=Scalable

[places/16]
Size=16
Context=Places
Type=Fixed

[places/22]
Size=22
Context=Places
Type=Fixed

[places/32]
Size=32
Context=Places
Type=Fixed
